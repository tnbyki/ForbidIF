男性     = PERSON + MALE_BODY

長髪     = HAIR = LONG
短髪     = HAIR = SHORT

スカート = COSTUME = SKIRT
ズボン   = COSTUME = PANTS

歩く     = POSE = WALK
座る     = POSE = SIT

右向き   = HEAD_DIRECTION = RIGHT
